  "items": [
    {
      "source_id": "SCA-0001",
      "title": "Log4Shell remote code execution in log4j-core 2.14.1",
      "severity": "critical",
      "rule": "dependency-vulnerability",
      "location": "payments-api/pom.xml",
      "cves": ["CVE-2021-44228"],
      "asset": "payments-api",
      "exposure": "internet",
      "asset_criticality": "high",
      "known_exploited": true,
      "description": "log4j-core 2.14.1 evaluates JNDI lookups in logged strings, which lets an attacker who controls a logged value load remote code.\nUpgrade to 2.17.1 or later.",
      "metadata": {
        "package": "org.apache.logging.log4j:log4j-core",
        "installed_version": "2.14.1",
        "fixed_version": "2.17.1"
      }
    },
